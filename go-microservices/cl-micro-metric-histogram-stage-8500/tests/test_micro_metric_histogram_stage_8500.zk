// cl-micro-metric-histogram-stage-8500: Test Suite
import "../mmh_8500.zk"

fn test_run():
    res := histogram_bucket_bound_8500(10.0, 2)
    diff := res - 439.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-micro-metric-histogram-stage-8500!")
