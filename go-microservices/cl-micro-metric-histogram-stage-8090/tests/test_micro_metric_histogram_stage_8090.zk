// cl-micro-metric-histogram-stage-8090: Test Suite
import "../mmh_8090.zk"

fn test_run():
    res := histogram_bucket_bound_8090(10.0, 2)
    diff := res - 418.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-micro-metric-histogram-stage-8090!")
